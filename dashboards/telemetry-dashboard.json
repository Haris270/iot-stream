                        "spec": {
                          "dataset": "iot-telemetry",
                          "editorMode": "code",
                          "format": "time_series",
                          "rawQuery": true,
                          "rawSql": "SELECT \n  $__timeGroup(time, '2s') AS \"time\",\n  -- 1. Divide by 5, drop the decimals, then multiply back by 5 to group into 5-degree bins!\n  -- 2. Cast that clean, low-cardinality number to text.\n  CAST(floor(temperature / 5) * 5 AS text) AS metric,   \n  COUNT(sensorid) AS value\nFROM sensor_data \nWHERE $__timeFilter(time)\nGROUP BY 1,2\nORDER BY 1 ASC;",
                          "sql": {
                            "columns": [
                              {
                                "parameters": [],
                                "type": "function"
                              }
                            ],
                            "groupBy": [
                              {
                                "property": {
                                  "type": "string"
                                },
                                "type": "groupBy"
                              }
                            ],
                            "limit": 50
                          }
                        }
                      },
                      "refId": "A",
                      "hidden": false
                    }
                  }
                ],
                "transformations": [],
                "queryOptions": {}
              }
            },
